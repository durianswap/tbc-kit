      "algorithm": "sha256",
      "encoding": "lowercase-hex",
      "domainSeparator": null,
      "consumers": ["ChainSwitchProposal", "ApprovalBinding", "ProviderSessionMutation"]
    },
    {
      "name": "workflowPlanHash",
      "inputSchema": "workflow.schema.json#/$defs/workflowPlanPayload",
      "canonicalization": "rfc8785-jcs-utf8",
      "algorithm": "sha256",
      "encoding": "lowercase-hex",
      "domainSeparator": null,
      "consumers": ["WorkflowPlan", "ApprovalBinding"]
    },
    {
