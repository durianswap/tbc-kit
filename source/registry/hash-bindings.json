      "algorithm": "sha256",
      "encoding": "lowercase-hex",
      "domainSeparator": null,
      "consumers": ["ChainSwitchProposal", "ApprovalBinding"]
    },
    {
      "name": "requestHash.workflow",
      "inputSchema": "workflow.schema.json#/$defs/request",
