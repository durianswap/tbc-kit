      "algorithm": "sha256",
      "encoding": "lowercase-hex",
      "domainSeparator": null,
      "consumers": ["ExecutionPlan", "ApprovalBinding"]
    },
    {
      "name": "requestHash.message",
      "inputSchema": "signing.schema.json#/$defs/messageRequest",
      "canonicalization": "rfc8785-jcs-utf8",
      "algorithm": "sha256",
      "encoding": "lowercase-hex",
      "domainSeparator": null,
      "consumers": ["ApprovalBinding"]
    },
    {
      "name": "requestHash.typedData",
      "inputSchema": "signing.schema.json#/$defs/typedDataRequest",
      "canonicalization": "rfc8785-jcs-utf8",
      "algorithm": "sha256",
      "encoding": "lowercase-hex",
      "domainSeparator": null,
      "consumers": ["ApprovalBinding"]
    },
    {
