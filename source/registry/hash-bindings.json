    {
      "name": "releaseFingerprint",
      "inputSchema": "integration.schema.json#/$defs/protocolRelease",
      "canonicalization": "rfc8785-jcs-utf8",
      "algorithm": "sha256",
      "encoding": "lowercase-hex",
      "domainSeparator": null,
      "consumers": ["OperationCheckpoint", "operationId"]
    },
    {
      "name": "checkpointHash",
      "inputSchema": "integration.schema.json#/$defs/operationCheckpointPayload",
      "canonicalization": "rfc8785-jcs-utf8",
      "algorithm": "sha256",
      "encoding": "lowercase-hex",
      "domainSeparator": null,
      "consumers": ["OperationCheckpoint", "Resume"]
    }
  ]
}
