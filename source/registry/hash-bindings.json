{
  "version": "1.0.0",
  "bindings": [
    {
      "name": "contextHash",
      "inputSchema": "integration.schema.json#/$defs/trustedContext",
      "canonicalization": "rfc8785-jcs-utf8",
      "algorithm": "sha256",
      "encoding": "lowercase-hex",
      "domainSeparator": null,
      "consumers": ["ApprovalBinding", "OperationCheckpoint", "operationId"]
    },
    {
      "name": "requestHash.transaction",
      "inputSchema": "transaction-request.schema.json#/$defs/transactionRequest",
