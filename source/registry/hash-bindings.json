      "algorithm": "sha256",
      "encoding": "lowercase-hex",
      "domainSeparator": null,
      "consumers": ["TransactionTemplate", "Finalize"]
    },
    {
      "name": "planHash",
      "inputSchema": "integration.schema.json#/$defs/executionPlanPayload",
      "canonicalization": "rfc8785-jcs-utf8",
      "algorithm": "sha256",
      "encoding": "lowercase-hex",
      "domainSeparator": null,
      "consumers": ["ExecutionPlan", "ApprovalBinding"]
