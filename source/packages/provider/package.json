{
  "name": "@tbc-wallet/provider",
  "version": "1.0.0-draft.6.15",
  "description": "Typed platform-neutral Provider for TBC Wallet Standard 1.0",
  "private": false,
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "react-native": "./dist/esm/index.js",
      "browser": "./dist/esm/index.js",
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.cjs",
      "default": "./dist/esm/index.js"
    },
    "./in-memory": {
      "types": "./dist/types/in-memory.d.ts",
      "react-native": "./dist/esm/in-memory.js",
      "browser": "./dist/esm/in-memory.js",
      "import": "./dist/esm/in-memory.js",
      "require": "./dist/cjs/in-memory.cjs",
      "default": "./dist/esm/in-memory.js"
    },
    "./webview": {
      "types": "./dist/types/webview.d.ts",
      "react-native": "./dist/esm/webview.js",
      "browser": "./dist/esm/webview.js",
      "import": "./dist/esm/webview.js",
      "require": "./dist/cjs/webview.cjs",
      "default": "./dist/esm/webview.js"
    }
  },
  "engines": {
    "node": ">=20"
  },
  "license": "CC0-1.0",
  "dependencies": {
    "@tbc-wallet/core": "1.0.0-draft.6.10"
  }
}
