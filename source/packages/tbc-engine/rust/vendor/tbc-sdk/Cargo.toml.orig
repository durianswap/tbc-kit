[package]
name = "tbc-sdk"
version = "0.3.0"
edition = "2024"
license = "MIT"
description = "Rust SDK for TuringBitChain transactions and contracts"
readme = "README.md"
repository = "https://github.com/LoongYearMeta/tbc-rust-sdk"
homepage = "https://github.com/LoongYearMeta/tbc-rust-sdk"
documentation = "https://docs.rs/tbc-sdk"
keywords = ["tbc", "blockchain", "sdk", "utxo"]
categories = ["cryptography", "api-bindings"]
exclude = ["examples/**", "docs/superpowers/**"]

[dependencies]
bip32 = { version = "0.5.3", default-features = false, features = ["secp256k1", "std"] }
bip39 = { version = "2.2.2", features = ["rand", "zeroize"] }
bs58 = "0.5"
hex = "0.4"
reqwest = { version = "0.12", default-features = false, features = ["json", "rustls-tls"] }
ripemd = "0.1"
rayon = "1"
secp256k1 = { version = "0.31", features = ["rand"] }
serde = { version = "1", features = ["derive"] }
serde_json = "1"
sha2 = "0.10"
thiserror = "2"
unicode-normalization = "0.1"
tokio = { version = "1", features = ["time"] }

[dev-dependencies]
tokio = { version = "1", features = ["macros", "rt-multi-thread", "test-util", "time"] }
