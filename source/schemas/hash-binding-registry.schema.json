{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://turingbitchain.io/tws/1.0/schemas/hash-binding-registry.schema.json",
  "title": "TWS hash binding registry",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "bindings"],
  "properties": {
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "bindings": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "inputSchema",
          "canonicalization",
          "algorithm",
          "encoding",
          "domainSeparator",
          "consumers"
        ],
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[a-z][A-Za-z0-9]*(?:\\.[A-Za-z][A-Za-z0-9]*)?$",
            "maxLength": 96
          },
          "inputSchema": {
            "type": "string",
            "pattern": "^[A-Za-z0-9.-]+\\.schema\\.json#/.+$",
            "maxLength": 256
          },
          "canonicalization": {
            "enum": ["rfc8785-jcs-utf8", "raw-bytes", "identity-hash32"]
          },
          "algorithm": { "const": "sha256" },
          "encoding": { "const": "lowercase-hex" },
          "domainSeparator": {
            "type": ["string", "null"],
            "maxLength": 128
          },
          "consumers": {
            "type": "array",
            "minItems": 1,
            "maxItems": 32,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            }
          }
        }
      }
    }
  }
}
