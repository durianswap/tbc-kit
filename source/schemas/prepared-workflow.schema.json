{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://turingbitchain.io/tws/1.0/schemas/prepared-workflow.schema.json",
  "title": "TWS DApp-prepared workflow",
  "$ref": "#/$defs/request",
  "$defs": {
    "dependsOn": {
      "type": "array",
      "maxItems": 4,
      "uniqueItems": true,
      "items": { "$ref": "common.schema.json#/$defs/localId" }
    },
    "preparedTransactionStep": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "dependsOn", "intent", "proposal"],
      "properties": {
        "id": { "$ref": "common.schema.json#/$defs/localId" },
        "kind": { "const": "preparedTransaction" },
        "dependsOn": { "$ref": "#/$defs/dependsOn" },
        "signingRoles": { "type": "array", "minItems": 1, "maxItems": 1, "items": { "$ref": "transaction-request.schema.json#/$defs/signingRole" } },
        "intent": {
          "$ref": "transaction-request.schema.json#/$defs/tbcIntent"
        },
        "proposal": {
          "$ref": "prepared-transaction.schema.json#/$defs/transactionProposal"
        },
        "constraints": {
          "$ref": "transaction-request.schema.json#/$defs/constraints"
        }
      },
      "allOf": [{ "$ref": "transaction-request.schema.json#/$defs/signingRoleIntentScope" }]
    },
    "step": {
      "oneOf": [
        { "$ref": "#/$defs/preparedTransactionStep" },
        { "$ref": "workflow.schema.json#/$defs/reviewedTransactionStep" },
        { "$ref": "workflow.schema.json#/$defs/messageStep" },
        { "$ref": "workflow.schema.json#/$defs/encryptStep" },
        { "$ref": "workflow.schema.json#/$defs/decryptStep" },
        { "$ref": "workflow.schema.json#/$defs/typedDataStep" }
      ]
    },
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "chainId", "from", "steps"],
      "properties": {
        "version": { "const": "1.0" },
        "chainId": { "$ref": "common.schema.json#/$defs/chainId" },
        "from": { "$ref": "common.schema.json#/$defs/address" },
        "clientRequestId": {
          "$ref": "common.schema.json#/$defs/clientRequestId"
        },
        "expiresAt": { "$ref": "common.schema.json#/$defs/rfc3339" },
        "maxTotalFee": {
          "$ref": "common.schema.json#/$defs/atomicAmount"
        },
        "failureMode": { "enum": ["atomic", "continue-independent"] },
        "steps": {
          "type": "array",
          "minItems": 1,
          "maxItems": 5,
          "items": { "$ref": "#/$defs/step" }
        }
      }
    }
  }
}
