{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://turingbitchain.io/tws/1.0/schemas/signing.schema.json",
  "title": "TWS message and typed data signing",
  "oneOf": [
    { "$ref": "#/$defs/messageRequest" },
    { "$ref": "#/$defs/typedDataRequest" }
  ],
  "$defs": {
    "utf8Message": {
      "type": "object",
      "additionalProperties": false,
      "required": ["encoding", "data"],
      "properties": {
        "encoding": { "const": "utf8" },
        "data": { "type": "string", "maxLength": 65536 }
      }
    },
    "hexMessage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["encoding", "data"],
      "properties": {
        "encoding": { "const": "hex" },
        "data": { "type": "string", "pattern": "^(?:[0-9a-f]{2})+$", "maxLength": 131072 }
      }
    },
    "base64Message": {
      "type": "object",
      "additionalProperties": false,
      "required": ["encoding", "data"],
      "properties": {
        "encoding": { "const": "base64" },
        "data": {
          "type": "string",
          "$ref": "common.schema.json#/$defs/base64",
          "maxLength": 87384
        }
      }
    },
    "encodedMessage": {
      "oneOf": [
        { "$ref": "#/$defs/utf8Message" },
        { "$ref": "#/$defs/hexMessage" },
        { "$ref": "#/$defs/base64Message" }
      ]
    },
    "messageCryptoAlgorithm": {
      "const": "tbc-bie1-secp256k1-aes128-cbc-hmac-sha256-v1"
    },
    "encryptedMessage": {
      "type": "string",
      "$ref": "common.schema.json#/$defs/base64",
      "minLength": 116,
      "maxLength": 174848
    },
    "messageRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "chainId", "from", "message"],
      "properties": {
        "version": { "const": "1.0" },
        "chainId": { "$ref": "common.schema.json#/$defs/chainId" },
        "from": { "$ref": "common.schema.json#/$defs/address" },
        "clientRequestId": { "$ref": "common.schema.json#/$defs/clientRequestId" },
        "message": { "$ref": "#/$defs/encodedMessage" }
      }
    },
    "dappTypedDomain": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "chainId"],
      "properties": {
        "name": { "type": "string", "minLength": 1, "maxLength": 64 },
        "version": { "type": "string", "pattern": "^[!-~]{1,32}$" },
        "chainId": { "$ref": "common.schema.json#/$defs/chainId" },
        "origin": {
          "type": "string",
          "format": "uri",
          "pattern": "^[a-z][a-z0-9+.-]*://[^/?#]+$",
          "maxLength": 2048
        },
        "verifyingContract": { "$ref": "common.schema.json#/$defs/contractId" },
        "salt": { "$ref": "common.schema.json#/$defs/hash32" }
      }
    },
    "typeField": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "type"],
      "properties": {
        "name": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_]{0,63}$" },
        "type": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_]*(?:\\[(?:[1-9][0-9]{0,2})?\\])?$"
        }
      }
    },
    "typeMap": {
      "type": "object",
      "minProperties": 1,
      "maxProperties": 32,
      "propertyNames": { "pattern": "^[A-Za-z][A-Za-z0-9_]{0,63}$" },
      "additionalProperties": {
        "type": "array",
        "minItems": 1,
        "maxItems": 64,
        "items": { "$ref": "#/$defs/typeField" }
      }
    },
    "typedJsonValue": {
      "oneOf": [
        { "type": "string" },
        { "type": "boolean" },
        {
          "type": "array",
          "maxItems": 256,
          "items": { "$ref": "#/$defs/typedJsonValue" }
        },
        {
          "type": "object",
          "maxProperties": 64,
          "additionalProperties": { "$ref": "#/$defs/typedJsonValue" }
        }
      ]
    },
    "typedMessage": {
      "type": "object",
      "maxProperties": 64,
      "additionalProperties": { "$ref": "#/$defs/typedJsonValue" }
    },
    "typedData": {
      "type": "object",
      "additionalProperties": false,
      "required": ["domain", "types", "primaryType", "message"],
      "properties": {
        "domain": { "$ref": "#/$defs/dappTypedDomain" },
        "types": { "$ref": "#/$defs/typeMap" },
        "primaryType": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_]{0,63}$" },
        "message": { "$ref": "#/$defs/typedMessage" }
      }
    },
    "typedDataRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "chainId", "from", "data"],
      "properties": {
        "version": { "const": "1.0" },
        "chainId": { "$ref": "common.schema.json#/$defs/chainId" },
        "from": { "$ref": "common.schema.json#/$defs/address" },
        "clientRequestId": { "$ref": "common.schema.json#/$defs/clientRequestId" },
        "data": { "$ref": "#/$defs/typedData" }
      }
    },
    "messageEnvelope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "version", "message"],
      "properties": {
        "type": { "const": "tbc.message" },
        "version": { "const": "1.0" },
        "message": { "$ref": "#/$defs/encodedMessage" }
      }
    },
    "typedDataEnvelope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "version", "domain", "types", "primaryType", "message"],
      "properties": {
        "type": { "const": "tbc.typedData" },
        "version": { "const": "1.0" },
        "domain": { "$ref": "#/$defs/dappTypedDomain" },
        "types": { "$ref": "#/$defs/typeMap" },
        "primaryType": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_]{0,63}$" },
        "message": { "$ref": "#/$defs/typedMessage" }
      }
    },
    "signInDetails": {
      "type": "object",
      "additionalProperties": false,
      "required": ["domain", "uri", "address", "chainId", "nonce", "issuedAt", "expirationTime"],
      "properties": {
        "domain": { "type": "string", "minLength": 1, "maxLength": 255 },
        "uri": { "type": "string", "format": "uri", "maxLength": 2048 },
        "address": { "$ref": "common.schema.json#/$defs/address" },
        "chainId": { "$ref": "common.schema.json#/$defs/chainId" },
        "nonce": { "type": "string", "pattern": "^[A-Za-z0-9_-]{16,128}$" },
        "issuedAt": { "$ref": "common.schema.json#/$defs/rfc3339" },
        "expirationTime": { "$ref": "common.schema.json#/$defs/rfc3339" },
        "statement": { "type": "string", "minLength": 1, "maxLength": 256, "pattern": "^[^\\r\\n\\u0000-\\u001f\\u007f]+$" }
      }
    },
    "signatureResultBase": {
      "type": "object",
      "required": ["version", "scheme", "algorithm", "address", "accountId", "publicKey", "envelope", "canonical", "digest", "signature"],
      "properties": {
        "version": { "const": "1.0" },
        "scheme": { "enum": ["tbc-message", "tbc-typed-data", "legacy-bitcoin-message"] },
        "algorithm": { "const": "secp256k1-recoverable-ecdsa-sha256d" },
        "address": { "$ref": "common.schema.json#/$defs/address" },
        "accountId": { "$ref": "common.schema.json#/$defs/accountId" },
        "publicKey": { "$ref": "common.schema.json#/$defs/publicKey" },
        "envelope": { "type": "object" },
        "canonical": { "type": "string", "minLength": 2, "maxLength": 65536 },
        "signingPayload": { "$ref": "common.schema.json#/$defs/base64" },
        "digest": { "$ref": "common.schema.json#/$defs/hash32" },
        "signature": { "$ref": "common.schema.json#/$defs/base64" }
      }
    },
    "messageSignature": {
      "allOf": [
        { "$ref": "#/$defs/signatureResultBase" },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "version": true,
            "scheme": { "enum": ["tbc-message", "legacy-bitcoin-message"] },
            "algorithm": true,
            "address": true,
            "accountId": true,
            "publicKey": true,
            "envelope": { "$ref": "#/$defs/messageEnvelope" },
            "canonical": true,
            "signingPayload": true,
            "digest": true,
            "signature": true
          },
          "oneOf": [
            {
              "required": ["scheme", "signingPayload"],
              "properties": {
                "scheme": { "const": "tbc-message" },
                "signingPayload": true
              }
            },
            {
              "required": ["scheme"],
              "properties": {
                "scheme": { "const": "legacy-bitcoin-message" },
                "signingPayload": false
              }
            }
          ]
        }
      ]
    },
    "typedDataSignature": {
      "allOf": [
        { "$ref": "#/$defs/signatureResultBase" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["scheme", "signingPayload"],
          "properties": {
            "version": true,
            "scheme": { "const": "tbc-typed-data" },
            "algorithm": true,
            "address": true,
            "accountId": true,
            "publicKey": true,
            "envelope": { "$ref": "#/$defs/typedDataEnvelope" },
            "canonical": true,
            "signingPayload": { "$ref": "common.schema.json#/$defs/base64" },
            "digest": true,
            "signature": true
          }
        }
      ]
    }
  }
}
