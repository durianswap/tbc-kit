{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://turingbitchain.io/tws/1.0/schemas/error-registry.schema.json",
  "title": "TWS error registry",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "version", "providerErrors", "executionErrors"],
  "properties": {
    "$schema": { "const": "../schemas/error-registry.schema.json" },
    "version": { "const": "1.0.0" },
    "providerErrors": {
      "type": "array",
      "minItems": 11,
      "maxItems": 11,
      "items": { "$ref": "#/$defs/providerError" }
    },
    "executionErrors": {
      "type": "array",
      "minItems": 16,
      "maxItems": 16,
      "items": { "$ref": "#/$defs/executionError" }
    }
  },
  "$defs": {
    "providerError": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "symbol", "category"],
      "properties": {
        "code": { "$ref": "provider.schema.json#/$defs/standardErrorCode" },
        "symbol": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]{1,63}$" },
        "category": { "enum": ["provider", "json-rpc", "tbc-execution"] }
      }
    },
    "executionError": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "stages"],
      "properties": {
        "name": { "$ref": "provider.schema.json#/$defs/executionErrorName" },
        "stages": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "provider.schema.json#/$defs/executionStage" }
        }
      }
    }
  }
}
