{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://turingbitchain.io/tws/1.0/schemas/operation-state-registry.schema.json",
  "title": "TWS operation state registry",
  "$defs": {
    "portOperationName": {
      "enum": [
        "accounts.resolve",
        "chainData.resolve",
        "policy.resolve",
        "permissionStore.load",
        "permissionStore.commit",
        "approval.request",
        "signer.sign",
        "crypto.execute",
        "reviewedTransaction.review",
        "reviewedTransaction.execute",
        "broadcast.submit",
        "broadcast.submitBatch",
        "broadcast.reconcile",
        "clock.now",
        "entropy.randomBytes"
      ]
    },
    "memoryFieldName": {
      "enum": [
        "trustedTime",
        "requestHash",
        "permissionLoads",
        "accountResolutions",
        "normalizedTransaction",
        "preparedTransaction",
        "chainSnapshot",
        "executionPolicy",
        "workflowPolicies",
        "reviewedTransactionReviews",
        "executionPlan",
        "permissionProposal",
        "chainSwitchProposal",
        "messageEnvelope",
        "typedDataEnvelope",
        "workflowPlan",
        "workflowResult",
        "approvalBinding",
        "approvalPreview",
        "approvalReceipt",
        "signingTasks",
        "signatures",
        "cryptoResults",
        "reviewedTransactionResults",
        "finalizedBundle",
            "workflowProgress",
            "walletActionPlan",
        "permissionCommit",
        "broadcastProgress",
        "providerSessionMutation",
        "providerSessionCommitAck",
        "providerCompletion"
      ]
    }
  },
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "states", "methodPaths", "expiryPolicy", "lateResponsePolicy", "cancellationReasons"],
  "properties": {
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "states": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "terminal",
          "requiredArtifacts",
          "allowedTransitions",
          "allowedPortOperations",
          "allowsContinue",
          "memoryRequired",
          "memoryAllowed"
        ],
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[a-z][a-z-]*$",
            "maxLength": 48
          },
          "terminal": { "type": "boolean" },
          "requiredArtifacts": {
            "type": "array",
            "maxItems": 32,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^[A-Za-z][A-Za-z0-9.]*$",
              "maxLength": 96
            }
          },
          "allowedTransitions": {
            "type": "array",
            "maxItems": 20,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^[a-z][a-z-]*$",
              "maxLength": 48
            }
          },
          "allowedPortOperations": {
            "type": "array",
            "maxItems": 11,
            "uniqueItems": true,
            "items": { "$ref": "#/$defs/portOperationName" }
          },
          "allowsContinue": { "type": "boolean" },
          "memoryRequired": {
            "type": "array",
            "maxItems": 30,
            "uniqueItems": true,
            "items": { "$ref": "#/$defs/memoryFieldName" }
          },
          "memoryAllowed": {
            "type": "array",
            "maxItems": 30,
            "uniqueItems": true,
            "items": { "$ref": "#/$defs/memoryFieldName" }
          }
        }
      }
    },
    "methodPaths": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["category", "methods", "states"],
        "properties": {
          "category": {
            "type": "string",
            "pattern": "^[a-z][a-z-]*$",
            "maxLength": 64
          },
          "methods": {
            "type": "array",
            "minItems": 1,
            "maxItems": 16,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^[A-Za-z][A-Za-z0-9_]*$",
              "maxLength": 96
            }
          },
          "states": {
            "type": "array",
            "minItems": 2,
            "maxItems": 20,
            "items": {
              "type": "string",
              "pattern": "^[a-z][a-z-]*$",
              "maxLength": 48
            }
          }
        }
      }
    },
    "expiryPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["authorizationWindowSeconds", "narrowingSources", "afterExpiryForbiddenEffects", "expiredPartialBroadcast"],
      "properties": {
        "authorizationWindowSeconds": { "const": 300 },
        "narrowingSources": {
          "type": "array",
          "minItems": 6,
          "maxItems": 6,
          "uniqueItems": true,
          "items": { "enum": ["request", "snapshot", "policy", "plan", "approval", "workflow"] }
        },
        "afterExpiryForbiddenEffects": {
          "type": "array",
          "minItems": 7,
          "maxItems": 7,
          "uniqueItems": true,
          "items": { "enum": ["approval.request", "signer.sign", "crypto.execute", "reviewedTransaction.execute", "transaction.finalize", "broadcast.submit", "broadcast.submitBatch"] }
        },
        "expiredPartialBroadcast": {
          "type": "object",
          "additionalProperties": false,
          "required": ["allowedEffect", "maxAttempts"],
          "properties": {
            "allowedEffect": { "const": "broadcast.reconcile" },
            "maxAttempts": { "const": 1 }
          }
        }
      }
    },
    "lateResponsePolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["disposition", "advancesRevision", "classes"],
      "properties": {
        "disposition": { "const": "ignore" },
        "advancesRevision": { "const": false },
        "classes": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "uniqueItems": true,
          "items": { "enum": ["unknown", "late", "duplicate", "cancelled"] }
        }
      }
    },
    "cancellationReasons": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "reason",
          "terminalState",
          "delivery",
          "providerCode",
          "executionErrorName",
          "retryable"
        ],
        "properties": {
          "reason": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9_]*$",
            "maxLength": 64
          },
          "terminalState": {
            "enum": ["completed", "rejected", "failed", "cancelled"]
          },
          "delivery": { "enum": ["respond", "suppress", "conditional"] },
          "providerCode": { "type": ["integer", "null"] },
          "executionErrorName": {
            "type": ["string", "null"],
            "pattern": "^[A-Z][A-Z0-9_]*$",
            "maxLength": 64
          },
          "retryable": { "type": "boolean" }
        }
      }
    }
  }
}
