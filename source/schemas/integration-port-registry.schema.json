{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://turingbitchain.io/tws/1.0/schemas/integration-port-registry.schema.json",
  "title": "TWS wallet integration port registry",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "version", "errorNames", "forbiddenFieldNames", "validationPhases", "violationCodes", "ports"],
  "properties": {
    "$schema": { "const": "../schemas/integration-port-registry.schema.json" },
    "version": { "const": "1.0.0" },
    "errorNames": {
      "type": "array",
      "minItems": 9,
      "maxItems": 9,
      "uniqueItems": true,
      "items": { "$ref": "integration.schema.json#/$defs/portErrorName" }
    },
    "forbiddenFieldNames": {
      "type": "array",
      "minItems": 14,
      "maxItems": 14,
      "uniqueItems": true,
      "items": { "$ref": "integration.schema.json#/$defs/forbiddenFieldName" }
    },
    "validationPhases": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "uniqueItems": true,
      "items": { "$ref": "integration.schema.json#/$defs/validationPhase" }
    },
    "violationCodes": {
      "type": "array",
      "minItems": 26,
      "maxItems": 26,
      "uniqueItems": true,
      "items": { "$ref": "integration.schema.json#/$defs/violationCode" }
    },
    "ports": {
      "type": "array",
      "minItems": 11,
      "maxItems": 11,
      "items": { "$ref": "#/$defs/port" }
    }
  },
  "$defs": {
    "schemaRef": {
      "type": "string",
      "pattern": "^integration\\.schema\\.json#/\\$defs/[A-Za-z][A-Za-z0-9]*$"
    },
    "operation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "params", "result", "semantics"],
      "properties": {
        "name": { "$ref": "integration.schema.json#/$defs/operationName" },
        "params": {
          "type": "object",
          "additionalProperties": false,
          "required": ["schema"],
          "properties": {
            "schema": { "$ref": "#/$defs/schemaRef" }
          }
        },
        "result": {
          "type": "object",
          "additionalProperties": false,
          "required": ["schema"],
          "properties": {
            "schema": { "$ref": "#/$defs/schemaRef" }
          }
        },
        "semantics": {
          "type": "object",
          "additionalProperties": false,
          "required": ["replay"],
          "properties": {
            "replay": { "const": "exact-response-by-callId" },
            "atomicity": { "const": "all-or-none" },
            "conflict": { "const": "no-write" }
          }
        }
      }
    },
    "port": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "direction", "required", "trustClass", "purpose", "operations"],
      "properties": {
        "name": {
          "enum": ["accounts", "chainData", "policy", "permissionStore", "approval", "signer", "crypto", "reviewedTransaction", "broadcast", "clock", "entropy"]
        },
        "version": { "const": "1.0" },
        "direction": { "const": "core-to-host" },
        "required": { "type": "boolean" },
        "trustClass": {
          "enum": ["host-authority", "host-io", "host-secret-boundary", "host-time", "host-randomness"]
        },
        "purpose": { "type": "string", "minLength": 1, "maxLength": 256 },
        "operations": {
          "type": "array",
          "minItems": 1,
          "maxItems": 3,
          "items": { "$ref": "#/$defs/operation" }
        }
      }
    }
  }
}
