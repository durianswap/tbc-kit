{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://turingbitchain.io/tws/1.0/schemas/conformance-manifest.schema.json",
  "title": "TWS conformance manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "implementation",
    "twsVersion",
    "featureVersion",
    "profiles",
    "chainIds",
    "intents",
    "suite",
    "executedAt",
    "result"
  ],
  "properties": {
    "implementation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "platforms"],
      "properties": {
        "kind": { "enum": ["wallet", "core-library"] },
        "name": { "type": "string", "minLength": 1, "maxLength": 128 },
        "version": { "type": "string", "minLength": 1, "maxLength": 64 },
        "platforms": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": ["ios", "android", "browser", "desktop", "web", "other"]
          }
        },
        "releaseArtifact": { "type": "string", "format": "uri", "maxLength": 2048 }
      }
    },
    "twsVersion": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "featureVersion": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "profiles": {
      "type": "array",
      "minItems": 2,
      "uniqueItems": true,
      "contains": { "const": "core" },
      "items": {
        "enum": [
          "core",
          "assets",
          "defi",
          "integration",
          "transport:webview",
          "transport:extension",
          "transport:remote"
        ]
      }
    },
    "chainIds": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "common.schema.json#/$defs/chainId" }
    },
    "intents": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": { "pattern": "^tbc\\.[A-Za-z][A-Za-z0-9.]*$" },
      "additionalProperties": {
        "type": "array",
        "minItems": 1,
        "uniqueItems": true,
        "items": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+$" }
      }
    },
    "suite": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "sha256"],
      "properties": {
        "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
        "sha256": { "$ref": "common.schema.json#/$defs/hash32" }
      }
    },
    "executedAt": { "$ref": "common.schema.json#/$defs/rfc3339" },
    "result": { "const": "pass" },
    "securityReview": { "type": "string", "format": "uri", "maxLength": 2048 },
    "signature": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "publicKey", "value"],
      "properties": {
        "algorithm": { "type": "string", "minLength": 1, "maxLength": 64 },
        "publicKey": { "type": "string", "minLength": 1, "maxLength": 256 },
        "value": { "type": "string", "minLength": 1, "maxLength": 1024 }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "type": "object",
        "properties": {
          "profiles": { "type": "array", "contains": { "const": "assets" } }
        }
      },
      "then": {
        "type": "object",
        "properties": {
          "profiles": { "type": "array", "contains": { "const": "core" } }
        }
      }
    },
    {
      "if": {
        "type": "object",
        "properties": {
          "profiles": { "type": "array", "contains": { "const": "defi" } }
        }
      },
      "then": {
        "type": "object",
        "properties": {
          "profiles": {
            "type": "array",
            "allOf": [
              { "type": "array", "contains": { "const": "core" } },
              { "type": "array", "contains": { "const": "assets" } }
            ]
          }
        }
      }
    },
    {
      "if": {
        "type": "object",
        "properties": {
          "implementation": {
            "type": "object",
            "properties": { "kind": { "const": "core-library" } },
            "required": ["kind"]
          }
        },
        "required": ["implementation"]
      },
      "then": {
        "type": "object",
        "properties": {
          "profiles": {
            "type": "array",
            "contains": { "const": "integration" }
          }
        }
      },
      "else": {
        "type": "object",
        "properties": {
          "profiles": {
            "type": "array",
            "contains": {
              "enum": ["transport:webview", "transport:extension", "transport:remote"]
            }
          }
        }
      }
    }
  ]
}
