{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://turingbitchain.io/tws/1.0/schemas/common.schema.json",
  "title": "TBC Wallet Standard common types",
  "$defs": {
    "chainId": {
      "type": "string",
      "pattern": "^tbc:[a-z0-9_-]{1,32}$"
    },
    "accountId": {
      "type": "string",
      "pattern": "^tbc:[a-z0-9_-]{1,32}:[1-9A-HJ-NP-Za-km-z]{26,64}$"
    },
    "address": {
      "type": "string",
      "pattern": "^[1-9A-HJ-NP-Za-km-z]{26,64}$"
    },
    "publicKey": {
      "type": "string",
      "pattern": "^(02|03)[0-9a-f]{64}$"
    },
    "hash32": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "deterministicId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{42}[AEIMQUYcgkosw048]$"
    },
    "atomicAmount": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)$"
    },
    "positiveAtomicAmount": {
      "type": "string",
      "pattern": "^[1-9][0-9]*$"
    },
    "uint32String": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]{0,9})$",
      "$comment": "The semantic validator MUST also enforce a numeric value no greater than 4294967295."
    },
    "contractId": {
      "$ref": "#/$defs/hash32"
    },
    "transactionId": {
      "$ref": "#/$defs/hash32"
    },
    "rawTransaction": {
      "type": "string",
      "pattern": "^(?:[0-9a-f]{2})+$"
    },
    "rfc3339": {
      "type": "string",
      "format": "date-time",
      "$comment": "UTC, seconds or 1-3 fractional digits accepted. New timestamps use three millisecond digits. Preserve original text after hashing/binding; compare instants, not strings. Not a chain locktime format.",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,3})?Z$"
    },
    "clientRequestId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "opaqueId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "localId": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9._-]{0,63}$"
    },
    "base64": {
      "type": "string",
      "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$"
    },
    "base64urlNoPadding": {
      "type": "string",
      "minLength": 22,
      "pattern": "^(?:[A-Za-z0-9_-]{4})*(?:[A-Za-z0-9_-]{2}|[A-Za-z0-9_-]{3})?$"
    },
    "safeInteger": {
      "type": "integer",
      "minimum": -9007199254740991,
      "maximum": 9007199254740991
    }
  }
}
